rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMgr() { return request.auth != null && request.auth.token.email == 'manager@pvpnerds.app'; }

    match /signups/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['tid','ign','ts'])
        && request.resource.data.tid is string && request.resource.data.ts is number
        && request.resource.data.ign.matches('^[A-Za-z0-9_]{3,16}$')
        && id == request.resource.data.tid + '_' + request.resource.data.ign.lower();
      allow update, delete: if false;
    }
    match /warmup/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','days','hotkeys'])
        && request.resource.data.name is string && id.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.name.lower() == id
        && (!('hotkeys' in request.resource.data)
            || (request.resource.data.hotkeys is list && request.resource.data.hotkeys.size() >= 1 && request.resource.data.hotkeys.size() <= 12));
      allow update: if request.resource.data.keys().hasOnly(['name','days','hotkeys'])
        && request.resource.data.name.lower() == id
        && (!('hotkeys' in resource.data) || request.resource.data.hotkeys == resource.data.hotkeys);
      allow delete: if false;
    }
    // ELO system
    match /players/{id} {
      allow read: if true;
      allow create: if isMgr() || (request.resource.data.keys().hasOnly(['name','ts'])
        && id.matches('^[a-z0-9_]{3,16}$') && request.resource.data.name is string && request.resource.data.name.lower() == id);
      allow update, delete: if isMgr();
    }
    match /queue/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','discord','mode','ts'])
        && request.resource.data.name is string && request.resource.data.name.matches('^[A-Za-z0-9_]{3,16}$')
        && request.resource.data.name.lower() == id
        && request.resource.data.discord is string && request.resource.data.discord.size() <= 40
        && request.resource.data.mode is string && request.resource.data.ts is number;
      allow update: if false;
      allow delete: if true;
    }
    match /pairs/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['mode','a','b','names','ts']);
      allow update, delete: if isMgr();
    }
    match /config/{id} { allow read: if true; allow write: if isMgr(); }
    match /elolog/{id} { allow read, write: if isMgr(); }
    match /tierlog/{id} { allow read, write: if isMgr(); }
    match /{other=**} { allow read, write: if false; }
  }
}
