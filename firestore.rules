rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /signups/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['tid','ign','ts'])
        && request.resource.data.tid is string
        && request.resource.data.ts is number
        && request.resource.data.ign.matches('^[A-Za-z0-9_]{3,16}$')
        && id == request.resource.data.tid + '_' + request.resource.data.ign.lower();
      allow update, delete: if false;
    }
    match /warmup/{id} {
      allow read: if true;
      // Players register once: hotkeys are written at creation and then locked.
      allow create: if request.resource.data.keys().hasOnly(['name','days','hotkeys'])
        && request.resource.data.name is string
        && id.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.name.lower() == id
        && (!('hotkeys' in request.resource.data)
            || (request.resource.data.hotkeys is list
                && request.resource.data.hotkeys.size() >= 1
                && request.resource.data.hotkeys.size() <= 12));
      allow update: if request.resource.data.keys().hasOnly(['name','days','hotkeys'])
        && request.resource.data.name.lower() == id
        && (!('hotkeys' in resource.data)
            || request.resource.data.hotkeys == resource.data.hotkeys);
      allow delete: if false;
    }
    match /{other=**} { allow read, write: if false; }
  }
}
